generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Idea {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String?
  type        String?
  model       String?
  status      String?
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([type])
}

model IntelItem {
  id          String   @id @default(cuid())
  title       String
  source      String
  sourceUrl   String   @unique
  publishedAt DateTime?
  topic       String
  summary     String
  credibility String   @default("primary")
  posture     String   @default("read")
  urgency     String   @default("routine")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([topic, publishedAt])
  @@index([posture, urgency])
}

model AgentState {
  id             String    @id
  name           String
  emoji          String?
  role           String?
  status         String    @default("offline")
  lastActive     DateTime?
  tasksCompleted Int       @default(0)
  totalCost      Float     @default(0)
  currentTask    String?
  recentActivity Json?     @default("[]")
  updatedAt      DateTime  @updatedAt
}

model AgentBusMessage {
  id        String   @id @default(uuid())
  fromAgent String
  toAgent   String
  type      String
  content   String
  metadata  Json?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())

  @@index([toAgent, read])
  @@index([fromAgent])
}

model DataStore {
  key       String   @id
  data      Json
  updatedAt DateTime @updatedAt
}

model Brief {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String
  source    String   @default("brief")
  createdAt DateTime @default(now())
}

model Mission {
  id          String    @id @default(uuid())
  agentId     String
  title       String
  description String
  status      String    @default("pending")
  priority    String    @default("medium")
  result      String?
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([agentId])
  @@index([status])
}

model AgentRequest {
  id            String    @id @default(cuid())
  origin        String    @default("web")
  kind          String    @default("oneshot")
  title         String
  prompt        String?
  sideEffecting Boolean   @default(false)
  status        String    @default("queued")
  result        String?
  error         String?
  hermesTaskId  String?
  decidedAt     DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([createdAt])
}

model AgentEvent {
  id        String   @id @default(cuid())
  kind      String   @default("activity")
  title     String
  detail    String?
  agent     String?
  level     String   @default("info")
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model HermesTask {
  id        String   @id
  board     String   @default("default")
  title     String
  assignee  String?
  status    String   @default("todo")
  priority  Int?
  result    String?
  updatedAt DateTime @default(now())
  syncedAt  DateTime @updatedAt

  @@index([board])
  @@index([status])
}

model HermesMemory {
  id         String    @id
  path       String
  type       String    @default("fact")
  title      String
  status     String    @default("active")
  confidence String?
  provenance String?
  tags       String[]
  links      String[]
  body       String    @default("")
  validFrom  DateTime?
  validTo    DateTime?
  updatedAt  DateTime  @default(now())
  syncedAt   DateTime  @updatedAt

  @@index([type])
  @@index([status])
}
